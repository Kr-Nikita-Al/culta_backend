# Copy these fields into the backend .env. Use a PRIVATE, dedicated backup bucket.
# Optional server overrides; without these, the existing local Podman setup is used.
# BACKUP_CONTAINER_COMMAND=docker
# BACKUP_DB_CONTAINER=main_db
# BACKUP_DB_USER=nikita
# BACKUP_DB_NAME=main_db
# BACKUP_DIRECTORY=/var/lib/culta/backups
# Never reuse the application image bucket or commit real credentials.
BACKUP_S3_ENDPOINT_URL=https://storage.yandexcloud.net
BACKUP_S3_REGION=ru-central1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
